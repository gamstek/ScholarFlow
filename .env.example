# ============================================================
# ScholarFlow 环境配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# ----- 数据库 -----
# PostgreSQL 连接地址（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5433/scholarflow

# ----- LLM 后端选择 -----
# ollama（本地）| deepseek | openai | qwen（云端）
LLM_BACKEND=ollama

# ----- 本地 Ollama（LLM_BACKEND=ollama 时生效）-----
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# ----- 云端 API（LLM_BACKEND=deepseek/openai/qwen 时生效）-----
# 仅当 LLM_BACKEND 设为 deepseek/openai/qwen 时需要配置以下三项
CLOUD_API_KEY=sk-your-api-key-here
# DeepSeek:   https://api.deepseek.com/v1
# OpenAI:     https://api.openai.com/v1
# Qwen 百炼:   https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_API_BASE=https://api.deepseek.com/v1
CLOUD_MODEL=deepseek-chat

# ----- 嵌入模型 -----
# 设为本地路径（如 embedding/bge-m3）可离线加载
# 留空或设为 BAAI/bge-m3 则从 HuggingFace 自动下载
BGE_MODEL_PATH=embedding/bge-m3

# Docker Compose 自动准备模型：首次下载，后续复用 embedding/bge-m3
# 默认使用 HuggingFace 官方源；仅本地下载需要加速时可取消注释
# HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=你的HuggingFaceToken

# ----- 外部 API Keys（可选，提升速率限制）-----
# Semantic Scholar: https://api.semanticscholar.org/ 免费注册（无 key 限 100次/5分钟）
# PubMed E-utilities: https://www.ncbi.nlm.nih.gov/account/ 免费注册（无 key 限 3次/秒）
SEMANTIC_SCHOLAR_API_KEY=YOUR_SEMANTIC_SCHOLAR_KEY
PUBMED_API_KEY=YOUR_PUBMED_KEY

# ----- 离线模式 -----
# 设为 1 禁止 HuggingFace 联网验证，纯本地缓存加载
HF_HUB_OFFLINE=1
